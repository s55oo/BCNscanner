# ============================================================
# BCNscanner configuration
# ------------------------------------------------------------
# This file is the single place for all station-specific data.
# It is NOT committed to git (.env is in .gitignore).
# config.env.example is the committed template - keep them in sync.
# No passwords are needed here (git uses SSH keys).
# ============================================================

# --- Listener location --------------------------------------
# Locator used as the center for beacon distances / bearings
LISTENING_GRID=JN76JG

# --- Rotator (antenna azimuth control) ----------------------
# Enabled: yes/no
ROTATOR_ENABLED=yes
# pstrotator-http : PstRotator embedded web server (AZ/EL HTML interface,
#                   commands /PstRotator.htm?az=NNN&el=NNN, status "AZ = n")
# pstrotator      : PstRotator XML over UDP control port
# gs232           : raw GS-232 over TCP
ROTATOR_TYPE=pstrotator-http
ROTATOR_HOST=10.147.17.206
ROTATOR_PORT=80
# UDP command port (pstrotator type only); reports arrive on port+1
ROTATOR_CMD_PORT=12000
# TCP port (gs232 type only)
ROTATOR_TCP_PORT=2000

# --- Radio (rig control via flrig or rigctld) ---------------
RADIO_ENABLED=yes
# Radio model - informational:
#   * flrig: flrig talks to the rig itself, the scanner only needs the
#     flrig host/port above; model is stored here for documentation
#   * rigctld: the hamlib model id matters when starting rigctld,
#     e.g.  rigctld -m <id> -r /dev/ttyUSB0 -s 57600
#     find the id with:  rigctld -l | grep -i kenwood
#     (TS-590SG uses its serial CAT at 57600 baud)
# To use another radio, change RADIO_MODEL below and point
# RADIO_HOST/RADIO_PORT at that radio's control server.
RADIO_MODEL=TS-590SG
# flrig   : flrig XML-RPC server (default port 12345)
# rigctld : hamlib rigctld TCP server (default port 4532)
RADIO_TYPE=flrig
RADIO_HOST=10.147.17.206
RADIO_PORT=12345
# Mode set when tuning (USB, CW, ...)
RADIO_TUNE_MODE=CW
# Transverter LO offset in Hz added to rig frequency readouts
# (130000000 -> rig 14.174 MHz reads as 144.174 MHz);
# subtracted again when tuning. Use 0 for no transverter.
RADIO_FREQ_OFFSET=130000000
